      "source": [
        "def attention(q, k, v, mask=None):\n",
        "\n",
        "    scores = torch.matmul(\n",
        "        q,\n",
        "        k.transpose(-2, -1)\n",
        "    )\n",
        "\n",
        "    scores = scores / np.sqrt(\n",
        "        q.size(-1)\n",
        "    )\n",
        "\n",
        "    if mask is not None:\n",
        "\n",
        "        scores = scores.masked_fill(\n",
        "            ~mask,\n",
        "            torch.finfo(\n",
        "                scores.dtype\n",
        "            ).min\n",
        "        )\n",
        "\n",
        "    weights = torch.softmax(\n",
        "        scores,\n",
        "        dim=-1\n",
        "    )\n",
        "\n",
        "    output = torch.matmul(\n",
        "        weights,\n",
        "        v\n",
        "    )\n",
        "\n",
        "    return output, weights"
      ],
