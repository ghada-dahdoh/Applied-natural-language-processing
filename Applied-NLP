        "def analyze_event(text):\n",
        "\n",
        "    # Normalize\n",
        "    clean = normalize_arabic(text)\n",
        "\n",
        "    # Privacy protection\n",
        "    masked = mask_pii(clean)\n",
        "\n",
        "    # Tokenization\n",
        "    tokens = tokenizer.tokenize(\n",
        "        masked\n",
        "    )\n",
        "\n",
        "    # Classification\n",
        "    encoded = tokenizer(\n",
        "        masked,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        padding=True,\n",
        "        max_length=64\n",
        "    )\n",
        "\n",
        "    encoded = {\n",
        "        key: value.to(device)\n",
        "        for key, value in encoded.items()\n",
        "    }\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = model(\n",
        "            **encoded\n",
        "        )\n",
        "\n",
        "        probabilities = torch.softmax(\n",
        "            outputs.logits,\n",
        "            dim=-1\n",
        "        )\n",
        "\n",
        "        predicted_id = torch.argmax(\n",
        "            probabilities,\n",
        "            dim=-1\n",
        "        ).item()\n",
        "\n",
        "        confidence = probabilities[\n",
        "            0,\n",
        "            predicted_id\n",
        "        ].item()\n",
        "\n",
        "    prediction = id2label[\n",
        "        predicted_id\n",
        "    ]\n",
        "\n",
        "    return {\n",
        "        \"original_text\": text,\n",
        "        \"clean_text\": clean,\n",
        "        \"masked_text\": masked,\n",
        "        \"tokens\": tokens,\n",
        "        \"token_count\": len(tokens),\n",
        "        \"event_type\": prediction,\n",
        "        \"confidence\": round(\n",
        "            confidence * 100,\n",
        "            2\n",
        "        )\n",
        "    }"
      ],
